{
  "schemaVersion": 1,
  "id": "jarvis-alerts",
  "version": "${version}",
  "name": "Jarvis Alerts",
  "description": "Meteor Client addon: voice alerts for totem pops, armor breaks and low HP of other players.",
  "authors": [
    "Tehnik, Claude"
  ],
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.jarvis.addon.JarvisAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "0,170,255",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
